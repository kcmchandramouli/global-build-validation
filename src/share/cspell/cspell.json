{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "enableGlobDot": true,
  "words": [
    "argcomplete",
    "argoproj",
    "autoscaling",
    "azuredevops",
    "azurerm",
    "checkov",
    "devcontainer",
    "dockerconfigjson",
    "docstrings",
    "doctest",
    "forcecolor",
    "gitops",
    "htmlcov",
    "jsonschema",
    "KEDA",
    "logissue",
    "markdownlint",
    "mypy",
    "noxfile",
    "pathlib",
    "posargs",
    "prettierrc",
    "rcfile",
    "setvariable",
    "setuptools",
    "venv",
    "virtualenv",
    "yamllint"
  ],
  "ignoreWords": [
    "auths",
    "chdir",
    "nindent",
    "nocolor",
    "noninteractive",
    "tempfile"
  ],
  "ignoreRegExpList": [
    "\\$\\{[^\\}]+\\}",
    "##vso\\[[^\\]]+\\]",
    "::(error|warning|notice)::"
  ],
  "ignorePaths": [
    "cspell.json",
    ".cspell.json",
    "**/.git/**",
    "**/pylint.rc",
    "**/pytest-coverage.rc",
    "**/.helmignore",
    "**/*.svg",
    "repos/**"
  ]
}
